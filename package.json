{
  "name": "callquarry",
  "version": "0.2.0",
  "description": "Multi-skill validation and wallet proof harness for Pharos agent Skills.",
  "type": "module",
  "bin": {
    "callquarry": "./scripts/callquarry.mjs"
  },
  "scripts": {
    "site": "python3 -m http.server 4173",
    "validate": "node scripts/callquarry.mjs validate --manifest examples/pharos-balance-target.json --offline",
    "validate:live": "node scripts/callquarry.mjs validate --manifest examples/pharos-balance-target.json --networks pharos-mainnet,pharos-atlantic-testnet",
    "validate:engine": "node scripts/callquarry.mjs validate --manifest examples/pharos-balance-target.json --networks pharos-mainnet,pharos-atlantic-testnet --pharos-engine",
    "prove-wallet:dry": "node scripts/callquarry.mjs prove-wallet --network pharos-atlantic-testnet",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "viem": "^2.52.2"
  }
}
